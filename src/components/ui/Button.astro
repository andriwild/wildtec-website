---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;
const linkAttributes = external ? { target: '_blank', rel: 'noopener' } : {};
---

<a class:list={['btn', variant]} href={href} {...linkAttributes}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 10px;
    border: 1px solid transparent;
    font: 600 15.5px/1 var(--body);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .primary {
    background: var(--ink);
    color: var(--on-ink);
  }

  .primary:hover {
    background: var(--ink-hover);
  }

  .ghost {
    background: var(--bg);
    color: var(--ink);
    border-color: var(--line);
  }

  .ghost:hover {
    border-color: var(--ink);
  }
</style>
