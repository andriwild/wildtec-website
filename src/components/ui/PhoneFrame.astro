---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Largest CSS width the phone is shown at; drives the generated image sizes. */
  width?: number;
  eager?: boolean;
  class?: string;
}

const { image, alt, width = 200, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <Image
    src={image}
    alt={alt}
    widths={[width, width * 2]}
    sizes={`${width}px`}
    loading={eager ? 'eager' : 'lazy'}
  />
</div>

<style>
  /* Parents size the phone by setting --w. */
  .phone {
    --w: 200px;
    flex: none;
    width: var(--w);
    max-width: 100%;
    aspect-ratio: 9 / 19.5;
    padding: calc(var(--w) * 0.035);
    border-radius: calc(var(--w) * 0.16);
    background: var(--frame);
    box-shadow:
      0 1px 0 1px rgb(255 255 255 / 0.06) inset,
      0 30px 60px -30px rgb(14 23 48 / 0.45),
      0 12px 24px -16px rgb(14 23 48 / 0.3);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: calc(var(--w) * 0.125);
    background: var(--bg-soft);
  }
</style>
