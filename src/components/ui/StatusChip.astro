---
import type { ProductStatus } from '../../data/products';
import type { Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n/translations';

interface Props {
  status: ProductStatus;
  locale: Locale;
}

const { status, locale } = Astro.props;
const t = useTranslations(locale);
---

<span class:list={['chip', status]}>{t.status[status]}</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    font: 600 12px/1 var(--body);
    white-space: nowrap;
  }

  .chip::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .live {
    color: var(--ok);
    background: var(--ok-soft);
  }

  .beta {
    color: var(--beta);
    background: var(--beta-soft);
  }

  .dev {
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
