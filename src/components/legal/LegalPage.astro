---
import type { Locale } from '../../i18n/locales';
import { routes } from '../../i18n/routes';
import { useTranslations } from '../../i18n/translations';

interface Props {
  title: string;
  locale: Locale;
}

const { title, locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="wrap">
  <div class="legal">
    <a class="back" href={routes.home(locale)}>← {t.legal.backHome}</a>
    <h1>{title}</h1>
    <slot />
  </div>
</div>

<style>
  .legal {
    display: grid;
    gap: 28px;
    max-width: 680px;
    padding-block: 40px 96px;
  }


  .back {
    width: fit-content;
    font-weight: 600;
    font-size: 15px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .legal :global(h2) {
    margin-bottom: 6px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .legal :global(p) {
    color: var(--muted);
  }
</style>
