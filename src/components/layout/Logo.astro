---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="brand" href={href} aria-label="Wild Tec">
  <svg viewBox="0 0 30 30" aria-hidden="true">
    <rect width="30" height="30" rx="8" fill="var(--ink)"></rect>
    <polyline
      points="6.5,9 10.5,21 15,12.5 19.5,21 23.5,9"
      fill="none"
      stroke="var(--bg)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"></polyline>
  </svg>
  <span>Wild Tec</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  svg {
    width: 30px;
    height: 30px;
    flex: none;
  }

  span {
    font: 700 19px/1 var(--display);
    letter-spacing: -0.01em;
  }
</style>
