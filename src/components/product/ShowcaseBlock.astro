---
import { Image } from 'astro:assets';
import type { Showcase } from '../../data/products';
import type { Locale } from '../../i18n/locales';

interface Props {
  showcase: Showcase;
  locale: Locale;
  /** Puts the image on the right, to alternate consecutive blocks. */
  reverse?: boolean;
  tint: string;
}

const { showcase, locale, reverse = false, tint } = Astro.props;
---

<div class:list={['wrap', 'showcase', { reverse }]}>
  <div class="media" style={`--tint: ${tint}`}>
    <Image
      src={showcase.image[locale]}
      alt={showcase.alt[locale]}
      widths={[560, 1120]}
      sizes="(max-width: 760px) 100vw, 560px"
      loading="lazy"
    />
  </div>
  <div class="copy">
    <span class="eyebrow">{showcase.eyebrow[locale]}</span>
    <h2>{showcase.title[locale]}</h2>
    <p class="lead">{showcase.text[locale]}</p>
  </div>
</div>

<style>
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    padding-block: 32px;
  }

  .reverse .media {
    order: 2;
  }

  .media {
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
    border-radius: 20px;
    background: var(--tint);
  }

  /* Portrait images (phone + watch) stay compact; landscape ones fill the width. */
  .media img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 420px;
    mix-blend-mode: multiply;
  }

  .copy {
    display: grid;
    gap: 14px;
  }

  @media (max-width: 760px) {
    .showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .reverse .media {
      order: 0;
    }
  }
</style>
